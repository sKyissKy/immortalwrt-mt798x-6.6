#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only

START=55
STOP=15
USE_PROCD=1

start_service() {
	/usr/sbin/mtk-npu-sqm start
}

stop_service() {
	/usr/sbin/mtk-npu-sqm stop
}

reload_service() {
	/usr/sbin/mtk-npu-sqm reload
}

service_triggers() {
	procd_add_reload_trigger "mtk_npu_sqm"
}
