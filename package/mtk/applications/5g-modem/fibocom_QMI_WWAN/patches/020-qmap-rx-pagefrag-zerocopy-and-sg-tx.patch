+static struct sk_buff *qmap_build_rx_skb(struct net_device *net,
+                                         struct sk_buff *skb_in,
+                                         const u8 *payload,
+                                         unsigned int pkt_len,
+                                         unsigned int extra_headroom)
+{
+    unsigned int headroom = ETH_HLEN + 32 + extra_headroom;
+    struct sk_buff *qmap_skb;
+
+    if (skb_in->head_frag && !skb_is_nonlinear(skb_in) && pkt_len > 256) {
+        struct page *head_page = virt_to_head_page(skb_in->head);
+        unsigned int frag_len = pkt_len - 128;
+
+        qmap_skb = __netdev_alloc_skb(net, headroom + 128, GFP_ATOMIC);
+        if (!qmap_skb)
+            return NULL;
+        skb_reserve(qmap_skb, headroom);
+        skb_put_data(qmap_skb, payload, 128);
+        page_ref_inc(head_page);
+        skb_add_rx_frag(qmap_skb, 0, head_page,
+                        (const u8 *)(payload + 128) -
+                        (const u8 *)page_address(head_page),
+                        frag_len, SKB_DATA_ALIGN(frag_len));
+        return qmap_skb;
+    }
+
+    qmap_skb = __netdev_alloc_skb(net, headroom + pkt_len, GFP_ATOMIC);
+    if (!qmap_skb)
+        return NULL;
+    skb_reserve(qmap_skb, headroom);
+    skb_put_data(qmap_skb, payload, pkt_len);
+    return qmap_skb;
+}
