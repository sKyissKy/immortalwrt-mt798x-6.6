#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only

[ "$ACTION" = "ifup" ] || [ "$ACTION" = "ifupdate" ] || [ "$ACTION" = "ifdown" ] || exit 0
case "$INTERFACE" in
	loopback|lan|ZeroTier*|vpn*) exit 0 ;;
esac

[ "$(uci -q get mtk_qos.global.enabled 2>/dev/null)" = "1" ] || exit 0
/usr/sbin/mtk-qos reload >/dev/null 2>&1 || true
