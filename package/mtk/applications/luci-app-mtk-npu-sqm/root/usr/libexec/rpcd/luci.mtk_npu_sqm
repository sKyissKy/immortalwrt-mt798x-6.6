#!/usr/bin/env ucode
// SPDX-License-Identifier: Apache-2.0
// Native ucode rpcd backend for luci-app-mtk-npu-sqm

'use strict';

import * as fs from 'fs';

function run_capture(cmd) {
	let pipe = fs.popen(cmd, 'r');
	if (!pipe)
		return '';
	let out = pipe.read('all') || '';
	pipe.close();
	return out;
}

function read_status_json() {
	let raw = trim(run_capture('/usr/sbin/mtk-npu-sqm json 2>/dev/null'));
	if (raw == '')
		return { error: 'empty status output' };
	try {
		return json(raw);
	}
	catch (e) {
		return { error: `invalid status json: ${e}`, raw: raw };
	}
}

const methods = {
	getStatus: {
		args: {},
		call: function() {
			print(sprintf('%J\n', read_status_json()));
		}
	},
	apply: {
		args: {},
		call: function() {
			let raw = run_capture('/etc/init.d/mtk_npu_sqm reload 2>&1; echo "__RC:$?"');
			let rc = 1;
			let m = match(raw, /__RC:(\d+)/);
			if (m)
				rc = int(m[1]);
			let clean_out = trim(replace(raw, /__RC:\d+\s*$/, ''));
			print(sprintf('%J\n', {
				code: rc,
				output: clean_out,
				status: read_status_json()
			}));
		}
	}
};

function parseInput() {
	let raw = '';
	while (true) {
		let chunk = fs.stdin.read(4096);
		if (!chunk || chunk == '')
			break;
		raw += chunk;
	}
	if (raw == '')
		return {};
	try {
		return json(raw);
	}
	catch (e) {
		print(sprintf('%J\n', { error: `${e}` }));
		exit(1);
	}
}

function validateArgs(func, uargs) {
	let method = methods[func];
	if (!method) {
		print(sprintf('%J\n', { error: 'Method not found' }));
		exit(1);
	}
	if (type(uargs) != 'object') {
		print(sprintf('%J\n', { error: 'Invalid arguments' }));
		exit(1);
	}
	delete uargs.ubus_rpc_session;
	let margs = method.args || {};
	for (let k, v in uargs) {
		if (!(k in margs) || (v != null && type(v) != type(margs[k]))) {
			print(sprintf('%J\n', { error: 'Invalid arguments' }));
			exit(1);
		}
	}
	return method;
}

if (ARGV[0] == 'list') {
	let rv = {};
	for (let name, method in methods)
		rv[name] = method.args || {};
	print(sprintf('%J\n', rv));
}
else if (ARGV[0] == 'call') {
	let args = parseInput();
	let method = validateArgs(ARGV[1], args);
	method.call(args);
	exit(0);
}
