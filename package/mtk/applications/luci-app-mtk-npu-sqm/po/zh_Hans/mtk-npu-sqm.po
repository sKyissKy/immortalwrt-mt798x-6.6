msgstr "已拦截（EQoS / mtkhqos 正在运行）"

msgid "Active (Hardware PPE + QDMA)"
msgstr "运行中（硬件 PPE + QDMA 加速）"

msgid "Active (CAKE Uplink Only)"
msgstr "运行中（仅 CAKE 上行整形）"

msgid "Stopped"
msgstr "已停止"

msgid "Hybrid (QDMA Hardware Downlink + CAKE Uplink)"
msgstr "混合模式（下行硬件 QDMA + 上行 CAKE）"

msgid "Full Hardware NPU QDMA (Bidirectional)"
msgstr "全硬件 NPU QDMA（双向硬件调度）"

msgid "Priority Q48"
msgstr "高优队列 Q48"

msgid "Flow Q49-63"
msgstr "公平队列 Q49-63"

msgid "Priority Q16"
msgstr "高优队列 Q16"

msgid "Flow Q17-31"
msgstr "公平队列 Q17-31"

msgid "None"
msgstr "无"

msgid "SQM Policy Settings"
msgstr "SQM 策略设置"

msgid "Enable NPU SQM QoS"
msgstr "启用 NPU SQM QoS"

msgid "WAN Interface"
msgstr "WAN 接口"

msgid "Auto Detect (5G wwan / Ethernet WAN)"
msgstr "自动识别（5G wwan / 以太网 WAN）"

msgid "Download Bandwidth (kbit/s)"
msgstr "下行带宽（kbit/s）"

msgid "Set 0 to disable downlink shaping. Recommended: 85-95% of measured download speed."
msgstr "设为 0 禁用下行限速；建议设置为实测下行速率的 85%-95%。"

msgid "Upload Bandwidth (kbit/s)"
msgstr "上行带宽（kbit/s）"

msgid "Set 0 to disable uplink shaping. On 5G wwan interfaces, CAKE runs on egress; on Ethernet WAN, QDMA Scheduler 2 handles uplink in hardware."
msgstr "设为 0 禁用上行限速；5G wwan 接口在出口运行 CAKE，以太网 WAN 由硬件 QDMA 调度器 2 处理。"

msgid "Hardware Queue Scheduler"
msgstr "硬件队列调度算法"

msgid "WRR (Weighted Round Robin)"
msgstr "WRR（加权轮询）"

msgid "SP (Strict Priority)"
msgstr "SP（严格优先级）"

msgid "Priority Queue Weight (1 - 15)"
msgstr "高优队列权重（1 - 15）"

msgid "Weight applied to hardware priority queues (Q16/Q48: small TCP ACKs, SYN/FIN/RST, DNS, NTP, EF/CS5-7 DSCP)."
msgstr "分配给硬件高优队列（Q16/Q48：TCP 小 ACK、SYN/FIN/RST、DNS、NTP、EF/CS5-7 DSCP）的权重。"

msgid "Flow-Fair Queue Weight (1 - 15)"
msgstr "公平流队列权重（1 - 15）"

msgid "Weight applied per queue across 15 hardware 5-tuple hash queues (Q17-31 UL / Q49-63 DL)."
msgstr "分配给 15 个硬件五元组哈希公平队列（上行 Q17-31 / 下行 Q49-63）的权重。"

msgid "Hardware Queue Buffer Reserve (1 - 15)"
msgstr "硬件队列缓冲保留量（1 - 15）"

msgid "CAKE DiffServ Mode (5G EXT Uplink)"
msgstr "CAKE 差分服务模式（5G EXT 上行）"

msgid "Enable CAKE ACK Filter (5G EXT Uplink)"
msgstr "启用 CAKE ACK 过滤（5G EXT 上行）"

msgid "Apply returned non-zero status"
msgstr "应用配置返回非零状态"

msgid "Configuration has been applied."
msgstr "配置已成功应用。"

msgid "Failed to apply configuration: %s"
msgstr "应用配置失败：%s"
