msgstr "实时运行状态"

msgid "Engine State"
msgstr "引擎状态"

msgid "Offload Mode"
msgstr "卸载模式"

msgid "Bound WAN Interface"
msgstr "绑定 WAN 接口"

msgid "HNAT Kernel Flags"
msgstr "HNAT 内核标志"

msgid "Downlink QDMA (Scheduler 3)"
msgstr "下行 QDMA（调度器 3）"

msgid "Uplink QDMA (Scheduler 2)"
msgstr "上行 QDMA（调度器 2）"

msgid "CAKE Uplink Qdisc"
msgstr "CAKE 上行队列规则"

