#!/bin/sh
logger -t wps "WPS button pressed: action=$ACTION" 2>/dev/null || true

if [ "$ACTION" = "pressed" ]; then
	command -v hostapd_cli >/dev/null 2>&1 && hostapd_cli -i wlan0 wps_pbc 2>/dev/null || true
	script="/usr/libexec/rpcd/luci.airpifanctrl"
	if [ -n "$FANCTRL_ROOT" ] && [ -f "${FANCTRL_ROOT}/usr/libexec/rpcd/luci.airpifanctrl" ]; then
		script="${FANCTRL_ROOT}/usr/libexec/rpcd/luci.airpifanctrl"
	fi
	ucode "$script" ctl wps >/dev/null
	exit $?
fi
