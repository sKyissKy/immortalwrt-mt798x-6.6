 			}
 		}
-		trace_printk("%s: called from %s fail\n", __func__, func);
+		pr_debug("%s: called from %s fail\n", __func__, func);
 		return -1;
 	}
 }
@@ -2028,7 +2028,7 @@
 				dev_queue_xmit(skb);
 				return 0;
 			}
-			trace_printk("%s: called from %s fail[MapE]\n", __func__,
