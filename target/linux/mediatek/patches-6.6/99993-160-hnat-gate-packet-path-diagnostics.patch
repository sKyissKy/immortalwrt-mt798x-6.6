@@ -2137,7 +2137,7 @@
 		skb->protocol = proto;
 		skb->dev = dev;
 		dev_queue_xmit(skb);
-		trace_printk("%s: called from %s successfully\n",
+		pr_debug("%s: called from %s successfully\n",
 			     __func__, func);
 		return 0;
 	}
@@ -2157,14 +2157,14 @@
 	skb_set_network_header(skb, 0);
 	skb_push(skb, ETH_HLEN);
 	dev_queue_xmit(skb);
-	trace_printk("%s: called from %s successfully\n", __func__, func);
+	pr_debug("%s: called from %s successfully\n", __func__, func);
 	return 0;
 }
 
