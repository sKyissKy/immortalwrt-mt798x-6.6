@@ -1033,6 +1035,10 @@
 	spinlock_t		cah_lock;
 	struct xlat_conf xlat;
 	spinlock_t		entry_lock;
+	struct delayed_work ppe_occupancy_work;
+	atomic64_t ppe_occupancy; /* bound entries in high 32 bits, total in low 32 */
+	bool ppe_occupancy_registered; /* protected by entry_lock */
+	bool ppe_occupancy_running; /* protected by entry_lock */
 	bool ipv6_en;
 	bool guest_en;
 	bool dscp_en;
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_nf_hook.c
@@ -5812,40 +5812,13 @@
 
 static void hnat_multitier_get_ppe_occupancy(u32 *bound, u32 *total)
 {
-	u32 b = 0, t = 0;
-	u32 i, idx;
-
-	if (!bound || !total)
-		return;
-
-	*bound = 0;
-	*total = 0;
-
-	if (!hnat_priv || !READ_ONCE(hnat_priv->fe_base))
-		return;
-
-	spin_lock_bh(&hnat_priv->entry_lock);
-	if (!hnat_priv->fe_base) {
-		spin_unlock_bh(&hnat_priv->entry_lock);
-		return;
-	}
-
-	for (i = 0; i < CFG_PPE_NUM && i < MAX_PPE_NUM; i++) {
-		const struct foe_entry *table = hnat_priv->foe_table_cpu[i];
-
-		if (!table || !hnat_priv->ppe_base[i])
-			continue;
-
-		t += hnat_priv->foe_etry_num;
-		for (idx = 0; idx < hnat_priv->foe_etry_num; idx++) {
-			if (table[idx].bfib1.state == BIND)
-				b++;
-		}
-	}
-	spin_unlock_bh(&hnat_priv->entry_lock);
-
-	*bound = b;
-	*total = t;
+	struct mtk_hnat *h = READ_ONCE(hnat_priv);
+	u64 snapshot = h ? atomic64_read(&h->ppe_occupancy) : 0;
+
+	if (bound)
+		*bound = upper_32_bits(snapshot);
+	if (total)
+		*total = lower_32_bits(snapshot);
 }
 
 static bool hnat_multitier_roam_flush(const u8 *mac,
