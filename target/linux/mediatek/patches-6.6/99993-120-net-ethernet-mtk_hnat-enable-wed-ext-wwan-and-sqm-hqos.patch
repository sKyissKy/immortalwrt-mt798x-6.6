+static bool hnat_sqm_is_prio_dscp(u8 dscp)
+{
+	switch (dscp >> 2) {
+	case 46: /* EF */
+	case 44: /* VA */
+	case 48: /* CS6 */
+	case 56: /* CS7 */
+	case 40: /* CS5 */
+	case 34: /* AF41 */
+	case 24: /* CS3 */
+		return true;
+	default:
+		return false;
+	}
+}
+
+static u32 hnat_sqm_classify_skb(const struct sk_buff *skb,
+				 unsigned int nh_off, __be16 proto,
+				 bool is_dl, bool per_pkt, u32 fallback_hash)
+{
+	u32 base = is_dl ? 48 : 16;
+	struct iphdr _iph;
+	const struct iphdr *iph;
+	struct ipv6hdr _ip6h;
+	const struct ipv6hdr *ip6h;
+	u8 l4_proto = 0;
+	unsigned int th_off = 0;
+	u32 hkey1 = 0, hkey2 = 0, hkey3 = 0, hash;
+
+	if (!skb)
+		return base + 1 + (fallback_hash % 15);
+
+	if (proto == htons(ETH_P_IP)) {
+		unsigned int ip_hlen;
+
+		iph = skb_header_pointer(skb, nh_off, sizeof(_iph), &_iph);
+		if (!iph || iph->ihl < 5)
+			return base + 1 + (fallback_hash % 15);
+		if (hnat_sqm_is_prio_dscp(iph->tos))
+			return base;
+
+		ip_hlen = iph->ihl * 4U;
+		l4_proto = iph->protocol;
+		th_off = nh_off + ip_hlen;
+		hkey1 = (__force u32)iph->saddr;
+		hkey2 = (__force u32)iph->daddr;
+		if (l4_proto == IPPROTO_TCP) {
+			struct tcphdr _th;
+			const struct tcphdr *th =
+				skb_header_pointer(skb, th_off, sizeof(_th), &_th);
+			if (th) {
+				unsigned int tcp_hlen = th->doff >= 5 ? th->doff * 4U : sizeof(_th);
+				u16 tot_len = ntohs(iph->tot_len);
+
+				if (per_pkt &&
+				    (tot_len <= ip_hlen + tcp_hlen ||
+				     th->syn || th->fin || th->rst))
+					return base;
+				if (ntohs(th->source) == 53 || ntohs(th->dest) == 53)
+					return base;
+				hkey3 = ((__force u32)th->source << 16) |
+					(__force u32)th->dest;
+			}
+		} else if (l4_proto == IPPROTO_UDP) {
+			struct udphdr _uh;
+			const struct udphdr *uh =
+				skb_header_pointer(skb, th_off, sizeof(_uh), &_uh);
+			if (uh) {
+				u16 sp = ntohs(uh->source), dp = ntohs(uh->dest);
+
+				if (sp == 53 || dp == 53 || sp == 123 || dp == 123)
+					return base;
+				hkey3 = ((__force u32)uh->source << 16) |
+					(__force u32)uh->dest;
+			}
+		}
+	} else if (proto == htons(ETH_P_IPV6)) {
+		u8 dscp;
+
+		ip6h = skb_header_pointer(skb, nh_off, sizeof(_ip6h), &_ip6h);
+		if (!ip6h)
+			return base + 1 + (fallback_hash % 15);
+		dscp = (u8)((ip6h->priority << 4) | (ip6h->flow_lbl[0] >> 4));
+		if (hnat_sqm_is_prio_dscp(dscp))
+			return base;
+
+		l4_proto = ip6h->nexthdr;
+		th_off = nh_off + sizeof(*ip6h);
+		hkey1 = (__force u32)(ip6h->saddr.s6_addr32[0] ^ ip6h->saddr.s6_addr32[3]);
+		hkey2 = (__force u32)(ip6h->daddr.s6_addr32[0] ^ ip6h->daddr.s6_addr32[3]);
+		if (l4_proto == NEXTHDR_TCP) {
+			struct tcphdr _th;
+			const struct tcphdr *th =
+				skb_header_pointer(skb, th_off, sizeof(_th), &_th);
+			if (th) {
+				unsigned int tcp_hlen = th->doff >= 5 ? th->doff * 4U : sizeof(_th);
+				u16 plen = ntohs(ip6h->payload_len);
+
+				if (per_pkt &&
+				    (plen <= tcp_hlen ||
+				     th->syn || th->fin || th->rst))
+					return base;
+				if (ntohs(th->source) == 53 || ntohs(th->dest) == 53)
+					return base;
+				hkey3 = ((__force u32)th->source << 16) |
+					(__force u32)th->dest;
+			}
+		} else if (l4_proto == NEXTHDR_UDP) {
+			struct udphdr _uh;
+			const struct udphdr *uh =
+				skb_header_pointer(skb, th_off, sizeof(_uh), &_uh);
+			if (uh) {
+				u16 sp = ntohs(uh->source), dp = ntohs(uh->dest);
+
+				if (sp == 53 || dp == 53 || sp == 123 || dp == 123)
+					return base;
+				hkey3 = ((__force u32)uh->source << 16) |
+					(__force u32)uh->dest;
+			}
+		}
+	} else {
+		return base + 1 + (fallback_hash % 15);
+	}
+
+	hash = jhash_3words(hkey1, hkey2, hkey3, l4_proto);
+	return base + 1 + (hash % 15);
+}
+
 unsigned int do_hnat_ext_to_ge(struct sk_buff *skb, const struct net_device *in,
 			       const char *func)
 {
 	struct net_device *ppdev = READ_ONCE(hnat_priv->g_ppdev);
 	int ext_idx;
+	__be16 l3_proto = 0;
 
 	if (!ppdev || !(ppdev->flags & IFF_UP)) {
 		trace_printk("%s: called from %s fail\n", __func__, func);
@@ -1215,6 +1345,7 @@
 		skb_push(skb, ETH_HLEN);
 	}
 	set_to_ppe(skb);
+	l3_proto = skb->protocol;
 
 	if (unlikely(skb_vlan_tag_present(skb))) {
 		__be16 vproto = skb->vlan_proto ? skb->vlan_proto :
@@ -1228,6 +1359,9 @@
 	/* set where we come from */
 	__vlan_hwaccel_put_tag(skb, htons(ETH_P_8021Q),
 			       VLAN_CFI_MASK | (ext_idx & VLAN_VID_MASK));
+	if (sqm_toggle && IS_HQOS_DL_MODE && !skb->mark)
+		skb->mark = hnat_sqm_classify_skb(skb, skb_network_offset(skb),
