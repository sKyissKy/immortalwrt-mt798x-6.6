 	dev_queue_xmit(skb);
 	return 0;
@@ -1274,7 +1408,8 @@
 
 		if (dev == READ_ONCE(ppd_dev))
 			skb->mark = 0x78681415;
-		else if (unlikely(skb->mark == 0x78681415))
+		else if (unlikely(skb->mark == 0x78681415) ||
+			 (sqm_toggle && skb->mark >= 48 && skb->mark <= 63))
 			skb->mark = 0;
 
 		set_from_extge(skb);
@@ -2068,6 +2203,9 @@
 	if (!hnat_skb_has_eth_hdr(skb))
 		return;
 
