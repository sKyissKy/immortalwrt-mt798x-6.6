+		return;
+
 	if (is_v6_ipip) {
 		if (skb_headroom(skb) <
 		    (unsigned int)(FOE_INFO_LEN + ipip_offset))
@@ -2830,7 +2968,7 @@
 
 	ct = nf_ct_get(skb, &ctinfo);
 
-	if ((IS_EXT(dev) && hnat_dev_is_rawip_ext(dev)) ||
+	if ((IS_EXT(dev) && hnat_dev_is_noarp_ext(dev)) ||
 	    !hnat_skb_has_eth_hdr(skb)) {
 		__be16 proto = hnat_skb_l3_proto(skb);
 
@@ -3407,8 +3545,19 @@
 		qid = port_id & MTK_QDMA_TX_MASK;
 	else
 		qid = 0;
-	if ((IS_HQOS_MODE) && (dscp!=0) &&(hnat_priv->dscp_en))
-		qid = (dscp>>2)& (MTK_QDMA_TX_MASK);
+	if (sqm_toggle && IS_HQOS_MODE && !(skb->mark & MTK_QDMA_TX_MASK)) {
+		if (IS_HQOS_UL_MODE && IS_WAN(dev) && !IS_EXT(dev))
+			qid = hnat_sqm_classify_skb(skb, skb_network_offset(skb),
+						    eth->h_proto, false, false,
+						    skb_hnat_entry(skb));
+		else if (IS_HQOS_DL_MODE && IS_LAN_GRP(dev) &&
+			 !FROM_EXT(skb) && skb_hnat_sport(skb) != NR_QDMA_PORT)
+			qid = hnat_sqm_classify_skb(skb, skb_network_offset(skb),
+						    eth->h_proto, true, false,
+						    skb_hnat_entry(skb));
+	} else if ((IS_HQOS_MODE) && (dscp != 0) && (hnat_priv->dscp_en)) {
+		qid = (dscp >> 2) & (MTK_QDMA_TX_MASK);
+	}
 
 	if (IS_PPPQ_MODE) {
 		qid+= gmac;
@@ -3461,12 +3610,17 @@
 				}
 			}
 
-			if (FROM_EXT(skb) || skb_hnat_sport(skb) == NR_QDMA_PORT)
+			if (FROM_EXT(skb) || skb_hnat_sport(skb) == NR_QDMA_PORT) {
 				entry.ipv4_hnapt.iblk2.fqos = 0;
 #if defined(CONFIG_MEDIATEK_NETSYS_V3)
+				entry.ipv4_hnapt.tport_id = 0;
+#endif
+			} else {
+#if defined(CONFIG_MEDIATEK_NETSYS_V3)
 				entry.ipv4_hnapt.tport_id = HQOS_FLAG(dev, skb, qid) ? 1 : 0;
 #endif
 				entry.ipv4_hnapt.iblk2.fqos = HQOS_FLAG(dev, skb, qid) ? 1 : 0;
+			}
 		} else {
 			entry.ipv4_hnapt.iblk2.fqos = 0;
 		}
@@ -3495,12 +3649,28 @@
 				}
 			}
 
-			if (FROM_EXT(skb) || skb_hnat_sport(skb) == NR_QDMA_PORT)
+			if (FROM_EXT(skb) || skb_hnat_sport(skb) == NR_QDMA_PORT) {
