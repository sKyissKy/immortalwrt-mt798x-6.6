From: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
Subject: [PATCH] net: ethernet: mtk_hnat: enable WED<->EXT WWAN offload and NPU SQM HQoS

Enable bidirectional MT7987/NETSYS v3 PPE hardware offload between WED
Wi-Fi 7 interfaces and no-ARP EXT cellular/tunnel devices (such as
Quectel RM520F-GL QMAP wwan0_1), prevent secondary QDMA loops on
FROM_EXT egress paths, guard mac rewrites on non-writable clones, and
add the NPU SQM per-flow/priority QDMA classifier controlled via
/sys/kernel/debug/hnat/sqm_toggle.

Signed-off-by: sKyissKy <29267720+sKyissKy@users.noreply.github.com>
---
diff -ruN -U3 a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
--- a/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
+++ b/drivers/net/ethernet/mediatek/mtk_hnat/hnat_debugfs.c
@@ -33,6 +33,7 @@
 int qos_ul_toggle = 1;
 int xlat_toggle;
 int tnl_toggle = 1;
+int sqm_toggle;
 struct hnat_desc headroom[DEF_ETRY_NUM];
 unsigned int dbg_cpu_reason_cnt[MAX_CRSN_NUM];
 
@@ -2942,6 +2943,56 @@
 	.release = single_release,
 };
 
+static int hnat_sqm_toggle_read(struct seq_file *m, void *private)
+{
+	seq_printf(m, "enabled=%d ul_base=16 dl_base=48 queues=16 qos_toggle=%d ul=%d dl=%d\n",
+		   sqm_toggle, qos_toggle, qos_ul_toggle, qos_dl_toggle);
+	return 0;
+}
+
+static int hnat_sqm_toggle_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, hnat_sqm_toggle_read, file->private_data);
+}
+
+static ssize_t hnat_sqm_toggle_write(struct file *file, const char __user *buffer,
+				     size_t count, loff_t *data)
+{
+	char buf[16] = { 0 };
+	int len = count;
+	int next_val;
+
+	if (len <= 0 || len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, buffer, len))
+		return -EFAULT;
+	buf[len] = '\0';
+
+	if (buf[0] == '0')
+		next_val = 0;
+	else if (buf[0] == '1')
+		next_val = 1;
+	else
+		return -EINVAL;
+
+	if (sqm_toggle != next_val) {
+		sqm_toggle = next_val;
+		if (hook_toggle)
+			foe_clear_all_bind_entries();
+		pr_info("hnat sqm_toggle=%d\n", sqm_toggle);
+	}
+
+	return len;
+}
+
+static const struct file_operations hnat_sqm_toggle_fops = {
+	.open = hnat_sqm_toggle_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.write = hnat_sqm_toggle_write,
+	.release = single_release,
+};
